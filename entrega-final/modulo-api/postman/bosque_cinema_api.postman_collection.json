{
  "info": {
    "name": "Bosque Cinema · API de integración PostgreSQL + MongoDB",
    "description": "Expone los casos de uso y la transacción cruzada del script de integración, con casos felices y de error.\n\nVariable `baseUrl` (por defecto http://localhost:8000). Con el Collection Runner cada petición ejecuta sus pruebas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "0. Estado",
      "description": "Comprueba que la API y los dos motores responden.",
      "item": [
        {
          "name": "Salud de los motores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Ambos motores ok\", function () { const j = pm.response.json(); pm.expect(j.postgresql).to.eql(\"ok\"); pm.expect(j.mongodb).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            },
            "description": "200 si PostgreSQL y MongoDB responden. Si no, 503 (conexión caída) o 500 (falta el .env)."
          }
        }
      ]
    },
