target="n132"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="807" y="856.0"/><mxPoint x="807" y="996.0"/></Array></mxGeometry></mxCell><mxCell id="n150" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;strokeColor=#A0522D;endArrow=open;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n109" target="n70"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n151" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;Línea azul: llave foránea dentro de PostgreSQL.&lt;br&gt;Línea morada punteada: identificador compartido entre PostgreSQL y MongoDB (no hay llave foránea entre motores; la integridad la valida la aplicación).&lt;br&gt;Línea café punteada: referencia interna en MongoDB (id_pelicula).&lt;br&gt;&lt;font color='#7B3FA0'&gt;[referencia]&lt;/font&gt; solo se guarda el id; el dato vive en PostgreSQL.  &lt;font color='#1E7F74'&gt;[embebido]&lt;/font&gt; el dato vive dentro del documento." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="840" y="1080" width="440" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
